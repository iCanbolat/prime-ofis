{
  "name": "prime-ofis",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @prime/shared --filter @prime/mock-data build && pnpm --parallel --filter @prime/shared --filter @prime/mock-data --filter @prime/api --filter @prime/client dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6"
  }
}
