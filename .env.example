# ─── Üretim (docker-compose.yml) ─────────────────────────────────────────────
# Kopyala: cp .env.example .env  — .env git'e girmez.

# Alan adı (Caddy otomatik HTTPS). Yerel denemede "localhost".
SITE_ADDRESS=localhost
APP_URL=https://localhost

POSTGRES_PASSWORD=degistir-guclu-bir-sifre
MINIO_ROOT_USER=prime
MINIO_ROOT_PASSWORD=degistir-en-az-8-karakter
# MinIO SSE-S3 anahtarı (isteğe bağlı): prime-anahtar:$(openssl rand -base64 32)
MINIO_KMS_SECRET_KEY=

# Üçüncü taraf gizli değerlerini (Luca, GİB/SGK, SMTP, Telegram, WhatsApp) şifreleyen anahtar.
# openssl rand -base64 32 — kaybedilirse kayıtlı gizli değerler çözülemez; yedekleyin.
SECRET_KEY=

# Claude ile PDF okuma (Faz 9–10)
CLAUDE_API_KEY=
CLAUDE_MODEL=

# CI'da üretilen imajlar (Faz 13): ghcr.io/<kullanıcı>/prime-ofis
IMAGE_PREFIX=prime-ofis
IMAGE_TAG=latest

# ─── Geliştirme (apps/api, `pnpm dev`) ───────────────────────────────────────
# apps/api/.env.example'a bakın; docker-compose.dev.yml ile uyumlu varsayılanlar orada.
