{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "strict": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  }
}
